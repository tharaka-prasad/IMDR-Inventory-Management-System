APP_NAME="IMDR Inventory Management System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=imdr_inventory
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database

FILESYSTEM_DISK=public

# IMDR System Defaults (overridable from Settings > System Settings after seeding)
IMDR_ASSET_PREFIX=IMDR
IMDR_QR_PREFIX=IMDR-QR
IMDR_DEFAULT_CURRENCY=LKR

VITE_APP_NAME="${APP_NAME}"
